{
  "name": "thundy-av",
  "version": "1.16.0",
  "description": "Thundy AV - opt-in email attachment and link scanner for Thunderbird (WebExtension, Manifest V3).",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/VaZuLeS/Thunderbird-Antivirus.git"
  },
  "homepage": "https://vazules.github.io/Thunderbird-Antivirus/",
  "bugs": {
    "url": "https://github.com/VaZuLeS/Thunderbird-Antivirus/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "NODE_PATH=node_modules node --test --test-reporter=spec",
    "lint": "web-ext lint --source-dir .",
    "build": "node scripts/build-xpi.js",
    "pre-submit-checks": "node ./scripts/pre-submit-checks.js",
    "check": "npm run pre-submit-checks && npm test",
    "build:web-ext": "web-ext build --source-dir . --artifacts-dir ./build"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "jsdom": "^30.1.1"
  }
}
