{
  "manifest_version": 3,
  "name": "Thunderbird SECurity AntiVirus",
  "author": "Jan Bludau",
  "version": "1.5.0",
  "description": "Prüft jeden E-Mail-Anhang über Hybrid Analysis (70+ Virenscanner) sowie URL- und IP-Reputation via urlscan.io, URLhaus und AbuseIPDB.",
  "homepage_url": "https://vazules.github.io/Thunderbird-Antivirus/",
  "browser_specific_settings": {
    "gecko": {
      "id": "jan@bludau-it-services.de",
      "strict_min_version": "115.0"
    },
    "thunderbird": {
      "id": "jan@bludau-it-services.de"
    }
  },
  "permissions": [
    "messagesRead",
    "https://hybrid-analysis.com/*",
    "webRequest",
    "storage",
    "notifications",
    "scripting",
    "downloads"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "scripts": [
      "api_gateway.js",
      "db.js",
      "background.js"
    ]
  },
  "message_display_action": {
    "default_icon": "img/icon-64px.jpg",
    "default_title": "Thundy AV Checker",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false,
    "browser_style": true
  },
  "icons": {
    "16": "img/icon-16px.jpg",
    "32": "img/icon-32px.jpg",
    "64": "img/icon-64px.jpg"
  }

}
