{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Thundy AV",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Jan Bludau",
  "version": "1.6.7",
  "homepage_url": "https://vazules.github.io/Thunderbird-Antivirus/",
  "browser_specific_settings": {
    "gecko": {
      "id": "thundy-av@bludau-it-services.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "personalCommunications"
        ]
      }
    }
  },
  "permissions": [
    "messagesRead",
    "storage",
    "notifications",
    "scripting",
    "downloads",
    "menus"
  ],
  "optional_permissions": [
    "sensitiveDataUpload"
  ],
  "optional_host_permissions": [
    "https://hybrid-analysis.com/*",
    "https://*.hybrid-analysis.com/*",
    "https://*.virustotal.com/*",
    "https://urlscan.io/*",
    "https://*.urlscan.io/*",
    "https://urlhaus-api.abuse.ch/*",
    "https://api.abuseipdb.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "background": {
    "scripts": [
      "db.js",
      "api_gateway.js",
      "background.js"
    ]
  },
  "message_display_action": {
    "default_icon": "img/icon-64px.png",
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "img/icon-16px.png",
    "32": "img/icon-32px.png",
    "48": "img/icon-48px.png",
    "64": "img/icon-64px.png",
    "128": "img/icon-128px.png"
  }
}
